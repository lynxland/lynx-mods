{
  "name": "task",
  "version": "0.7.0",
  "description": "后台任务与调度模块：持久化任务队列（即时/延迟/定时入队、唯一键防重、退避重试、死信）+ cron 周期规则 + 管理面（列表/重试/取消/规则/计数），零模块依赖；worker handler 经桥接包由应用接线",
  "modulePath": "github.com/lynxland/lynx-start/modules/task",
  "moduleDependencies": [],
  "goDependencies": [
    "github.com/lynxland/appkit@v0.8.0",
    "github.com/lynxland/appkit/contrib/bunx@v0.5.0",
    "github.com/lynxland/grpcapi@v0.5.0",
    "github.com/lynxland/lynx@v1.21.0",
    "github.com/robfig/cron/v3@v3.0.1"
  ],
  "configFragment": "task:\n  scheduler_interval: 30s  # 周期规则调度轮询间隔（cron 到期扫描）",
  "publishedEvents": [
    "task.job.enqueued",
    "task.job.completed",
    "task.job.failed",
    "task.job.dead"
  ],
  "kernelConstraint": ">=0.8.0"
}

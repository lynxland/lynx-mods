{
  "name": "organization",
  "version": "0.7.0",
  "description": "组织模块:组织与成员(角色分级 owner/admin/member)、邮件邀请流(一次性令牌+状态机+7 天过期)、所有权转让、软删,依赖 account",
  "modulePath": "github.com/lynxland/lynx-start/modules/organization",
  "moduleDependencies": [
    {
      "account": ">=0.6.0"
    }
  ],
  "goDependencies": [
    "github.com/lynxland/appkit@v0.8.0",
    "github.com/lynxland/appkit/contrib/bunx@v0.5.0",
    "github.com/lynxland/grpcapi@v0.5.0"
  ],
  "configFragment": "",
  "publishedEvents": [
    "organization.organization.created",
    "organization.member.added",
    "organization.member.removed",
    "organization.ownership.transferred",
    "organization.invite.created",
    "organization.invite.accepted"
  ],
  "kernelConstraint": ">=0.8.0"
}
